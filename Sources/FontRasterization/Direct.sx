use GFX.Font
use STD.Crypto
use STD.Time.Stopwatch

func require_face(result:Result<Font.Face, Font.Error>) Font.Face {
    match result {
        failure(error) => { panic(error.detail) }
        success(face) => { return face }
    }
}

func require_instance(result:Result<Font.Instance, Font.Error>) Font.Instance {
    match result {
        failure(error) => { panic(error.detail) }
        success(instance) => { return instance }
    }
}

func require_run(result:Result<Font.GlyphRun, Font.Error>) Font.GlyphRun {
    match result {
        failure(error) => { panic(error.detail) }
        success(run) => { return run }
    }
}

func require_glyph(result:Result<Font.GlyphCoverage?, Font.Error>) Font.GlyphCoverage? {
    match result {
        failure(error) => { panic(error.detail) }
        success(coverage) => { return coverage }
    }
}

func main() {
    let bytes = embed_bytes("../../../Packages/GFX.Font/Assets/Fonts/NotoSansMono-Regular.ttf")

    var hash_clock = Stopwatch()
    hash_clock.start()
    let digest = Crypto.sha256(@bytes[0:bytes.count()])
    hash_clock.stop()

    var face_clock = Stopwatch()
    face_clock.start()
    var face = require_face(Font.Face.monospace())
    face_clock.stop()

    var instance_clock = Stopwatch()
    instance_clock.start()
    var instance = require_instance(Font.Instance.create(face, size:14.0))
    instance_clock.stop()

    var shape_clock = Stopwatch()
    shape_clock.start()
    var run = require_run(instance.shape("office AVATAR café e\u{301} — first UI label"))
    shape_clock.stop()

    var raster_clock = Stopwatch()
    var alpha_count = 0
    var alpha_sum = 0
    raster_clock.start()
    for glyph in run.glyphs() {
        if coverage = require_glyph(instance.rasterize_glyph(
            glyph.id,
            Font.GlyphRasterOptions(density:2.0)
        )) {
            let alpha = coverage.alpha()
            alpha_count += alpha.count()
            for value in alpha { alpha_sum += value as int }
        }
    }
    raster_clock.stop()

    assert(digest == "65b5e2b2c4a1fba9ae8be1f026cb35b03dcb8886d9b2a4147054fde12f7e767d")
    assert(run.glyph_count() > 0)
    assert(alpha_count > 0)
    assert(alpha_sum > 0)
    print(
        "SILEX_FONT_DIRECT hash_ms=$(hash_clock.get_elapsed_milliseconds()) " +
        "face_ms=$(face_clock.get_elapsed_milliseconds()) " +
        "instance_ms=$(instance_clock.get_elapsed_milliseconds()) " +
        "shape_ms=$(shape_clock.get_elapsed_milliseconds()) " +
        "raster_ms=$(raster_clock.get_elapsed_milliseconds()) " +
        "glyphs=$(run.glyph_count()) alpha_count=$(alpha_count) alpha_sum=$(alpha_sum)"
    )
}
