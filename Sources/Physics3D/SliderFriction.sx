use GFX.Physics
use STD.Math

func run_slider_friction_case(case_id:int) {
    var gravity = Math.Vec3(0.0, -9.81, 0.0)
    if case_id == 3 { gravity = Math.Vec3() }
    if case_id == 7 { gravity = Math.Vec3(0.3, -9.81, 0.0) }
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = gravity)
    var first_settings = Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed
        ..allow_sleep = false ..collision_filter = Physics.CollisionFilter3D(mask_bits:0)
    if case_id == 3 { first_settings.body_type = Physics.BodyType3D.dynamic;first_settings.mass_properties = Physics.MassProperties3D(2.0,Math.Vec3(0.2)) }
    var first = world.create_rigid_body(first_settings)
    var anchor = Math.Vec3()
    var position = Math.Vec3()
    if case_id == 2 { anchor = Math.Vec3(0.0,0.5,0.0);position = Math.Vec3(0.0,-0.5,0.0) }
    var mass = 2.0
    var capacity = 2.0
    var speed = 1.0
    if case_id == 1 { speed = -1.0 }
    if case_id == 3 { mass = 8.0;capacity = 0.8 }
    if case_id == 4 { capacity = 0.5 }
    if case_id == 5 { capacity = 4.0 }
    if case_id == 7 { capacity = 1.0;speed = 0.0 }
    var body = world.create_rigid_body(Physics.RigidBody3DSettings() ..transform = Physics.Transform3D(position)
        ..mass_properties = Physics.MassProperties3D(mass,Math.Vec3(mass*0.1))
        ..allow_sleep = false ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
    body.set_linear_velocity(Math.Vec3(speed,0.0,0.0))
    var settings = Physics.SliderConstraint3DSettings() ..second_local_frame = Physics.Transform3D(anchor)
        ..maximum_friction_force = capacity
    if case_id == 5 { settings.motor = Physics.SliderMotor3D(0.5,2.0) }
    if case_id == 6 { settings.motor = Physics.SliderMotor3D(0.0,0.0) }
    var joint = world.create_slider_constraint(first,body,settings)
    var step = 1
    while step <= 360 {
        if case_id == 4 {
            if step == 61 { joint.set_maximum_friction_force(2.0) }
            if step == 181 { joint.set_maximum_friction_force(0.0);body.set_linear_velocity(Math.Vec3(-1.0,0.0,0.0)) }
            if step == 241 { joint.set_maximum_friction_force(1.0) }
        }
        if case_id == 5 {
            if step == 121 { joint.set_motor(Physics.SliderMotor3D.position(-0.4,10.0,8.0,8.0)) }
            if step == 301 { joint.set_motor(null) }
        }
        if case_id == 6 {
            if step == 121 { joint.set_motor(null) }
            if step == 181 { joint.set_motor(Physics.SliderMotor3D(0.0,0.0));body.set_linear_velocity(Math.Vec3(-1.0,0.0,0.0)) }
            if step == 241 { joint.set_motor(Physics.SliderMotor3D.position(0.0,0.0,8.0,8.0)) }
        }
        if case_id == 7 && step == 181 { joint.set_maximum_friction_force(0.2) }
        world.step(1.0 / 60.0)
        if step % 15 == 0 {
            print("slider-friction $(case_id) $(step) $(joint.position()) $(joint.speed()) $(first.linear_velocity().x) $(body.linear_velocity().x) $(body.position().x) $(body.position().y) $(first.angular_velocity().z) $(body.angular_velocity().z) $(joint.anchor_error().length()) $(joint.angular_error().length()) $(joint.reaction_force().x) $(joint.reaction_force().y) $(joint.limit_force()) $(joint.motor_force()) $(joint.friction_force()) $(joint.reaction_torque().z)")
        }
        step++
    }
}
func main() { var i = 0; while i < 8 { run_slider_friction_case(i); i++ } }
