use GFX.Physics
use STD.Math

func main() {
    let blade = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(0.1, 2.0, 0.1)))
    let wall = Physics.Shape3D.box(Physics.Box3D(Math.Vec3(0.1, 4.0, 4.0)))
    let mid = Physics.Transform3D(
        position:Math.Vec3(-0.4, 0.0, 0.0),
        rotation:Math.Quat.angle_axis(3.141592653589793 / 2.0,
            Math.Vec3(0.0, 0.0, 1.0)))
    print("mid_overlap=$(Physics.Geometry3D.overlaps(
        Physics.ShapePlacement3D(blade, mid),
        Physics.ShapePlacement3D(wall)))")
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = wall)
    var rotating = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..shape = blade
        ..transform = Physics.Transform3D(
            position:Math.Vec3(-0.4, 0.0, 0.0))
        ..angular_velocity = Math.Vec3(0.0, 0.0, 3.141592653589793 * 60.0)
        ..continuous_collision = true
        ..allow_sleep = false)
    world.step(1.0 / 60.0)
    print("contacts=$(world.contact_count())")
    print("final_x=$(rotating.position().x)")
}
