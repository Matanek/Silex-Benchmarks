use GFX.Physics
use STD.Math
use STD.Process

func vector(value:Math.Vec3) str { return "$(value.x) $(value.y) $(value.z)" }
func make(world:Physics.World3D) Physics.TrackedVehicle3D {
    var wheels:Physics.TrackedWheel3DSettings[]=[];var i=0
    let longitudinal=1.0;let lateral=0.15
    while i<6 {
        var x= -0.6;if i>=3 { x=0.6 }
        wheels.append(Physics.TrackedWheel3DSettings(Math.Vec3(x,0.0,(i%3-1) as float),longitudinal_friction:longitudinal,lateral_friction:lateral));i++
    }
    var vehicle=world.create_tracked_vehicle(Physics.TrackedVehicle3DSettings(
        Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.4,0.4,2.4)))
            ..mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(100.0))
            ..transform=Physics.Transform3D(Math.Vec3(1.0,1.15,0.0)) ..allow_sleep=false
            ..linear_damping=0.0 ..angular_damping=0.0 ..friction=0.0,wheels,
        Physics.VehicleTrack3DSettings(0,[0,1,2],inertia:2.0,angular_damping:0.0,maximum_brake_torque:1500.0,differential_ratio:6.0),
        Physics.VehicleTrack3DSettings(3,[3,4,5],inertia:2.0,angular_damping:0.0,maximum_brake_torque:1500.0,differential_ratio:6.0),
        engine:Physics.VehicleEngine3DSettings(maximum_torque:15.0,minimum_rpm:1000.0,maximum_rpm:6000.0,inertia:0.5,angular_damping:0.0,torque_curve:[Math.Vec2(0.0,1.0)]),
        transmission:Physics.VehicleTransmission3DSettings(mode:Physics.VehicleTransmissionMode3D.automatic,gear_ratios:[2.0,1.4,1.0],reverse_gear_ratios:[-2.0,-1.4,-1.0],shift_up_rpm:1800.0,shift_down_rpm:1200.0)))
    return vehicle
}
func command(vehicle:Physics.TrackedVehicle3D,platform:Physics.RigidBody3D,scenario:int,step:int,rate:int,combined:bool=false) {
    var spin=0.0
    if scenario>0 && step>=2*rate && step<4*rate { spin=0.25;if scenario==2 { spin= -spin } }
    platform.set_angular_velocity(Math.Vec3(0.0,spin,0.0))
    var speed=0.0;if combined && spin!=0.0 { speed=2.0;if scenario==2 { speed= -speed } }
    platform.set_linear_velocity(Math.Vec3(0.0,0.0,speed))
    var brake=1.0;if scenario==3 && (!combined || (step>=2*rate && step<4*rate)) { brake=0.0 }
    vehicle.set_controls(throttle:0.0,left_ratio:1.0,right_ratio:1.0,brake:brake)
}
func run(scenario:int,rate:int,combined:bool=false) {
    var world=Physics.World3D()
    var platform=world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.kinematic
        ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(8.0,0.4,12.0)))
        ..transform=Physics.Transform3D(Math.Vec3(0.0,-0.2,0.0)) ..friction=1.0 ..allow_sleep=false)
    var vehicle=make(world);var step=0
    while step<=rate*6 {
        var body=vehicle.chassis();let pose=body.transform();let power=vehicle.powertrain()
        let left=vehicle.track(Physics.VehicleTrackSide3D.left);let right=vehicle.track(Physics.VehicleTrackSide3D.right)
        var prefix="tracked-rotating-platform";if combined { prefix="tracked-combined-platform" }
        var text="$(prefix) $(scenario) $(rate) $(step) $(vector(pose.position)) $(vector(body.linear_velocity())) $(pose.rotation.x) $(pose.rotation.y) $(pose.rotation.z) $(pose.rotation.w) $(vector(body.angular_velocity())) $(power.engine_rpm) $(power.gear) $(power.clutch) $(left.angular_velocity) $(right.angular_velocity)"
        for i in [0,1,2,3,4,5] {
            let wheel=vehicle.wheel(i);var touching=0;if wheel.support()!=null { touching=1 }
            text+=" $(wheel.length) $(wheel.normal_force) $(wheel.angular_velocity) $(wheel.rotation_angle) $(wheel.longitudinal_force) $(wheel.lateral_force) $(touching) $(vector(wheel.contact_point)) $(vector(wheel.contact_normal)) $(vector(wheel.longitudinal_direction))"
        }
        let carrier=platform.transform()
        text+=" $(vector(carrier.position)) $(vector(platform.linear_velocity())) $(carrier.rotation.x) $(carrier.rotation.y) $(carrier.rotation.z) $(carrier.rotation.w) $(vector(platform.angular_velocity()))"
        print(text);if step==rate*6 { break }
        command(vehicle,platform,scenario,step,rate,combined);world.step(1.0/rate as float);step++
    }
    world.destroy_tracked_vehicle(vehicle)
}
func main() { var combined=false;for argument in Process.arguments() { if argument=="--combined" { combined=true } }
var scenario=0;while scenario<4 { for rate in [60,120] { run(scenario,rate,combined) }
scenario++ } }
