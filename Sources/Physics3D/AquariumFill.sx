use GFX.Physics
use STD.Math
use STD.Time.Clock

func wall(world:&Physics.World3D, size:Math.Vec3, position:Math.Vec3) {
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..shape = Physics.Shape3D.box(Physics.Box3D(size))
        ..transform = Physics.Transform3D(position:position))
}

// Horizontal aquarium and dispersed nozzle used by StressScene.
// A fixed 30 seconds at 60 Hz includes filling and subsequent settling.
// CSV: step, last_ms, awake, contacts, min_y, max_y, min_x, max_x,
// min_z, max_z, total_speed, total_spin, fast, spinning, mean_ms (60 steps),
// minimum center height over all steps so far.
func main() {
    var world = Physics.World3D()
    wall(world, Math.Vec3(10.08, 0.08, 5.08), Math.Vec3(0.0, -0.04, 0.0))
    wall(world, Math.Vec3(0.04, 4.0, 5.08), Math.Vec3(-5.02, 2.0, 0.0))
    wall(world, Math.Vec3(0.04, 4.0, 5.08), Math.Vec3(5.02, 2.0, 0.0))
    wall(world, Math.Vec3(10.0, 4.0, 0.04), Math.Vec3(0.0, 2.0, -2.52))
    wall(world, Math.Vec3(10.0, 4.0, 0.04), Math.Vec3(0.0, 2.0, 2.52))
    var bodies:Physics.RigidBody3D[] = []
    var emission = 0.0
    var timings:float[] = []
    var clock = Clock()
    var sum_ms = 0.0
    var minimum_floor = 1000.0
    var step = 0
    while step < 1800 {
        emission = Math.min(8.0, emission + (1.0 / 60.0) * 80.0)
        while emission >= 1.0 && bodies.count() < 1024 {
            let lane = (bodies.count() * 37) % 25
            let index = bodies.count()
            let spread = Math.sin(index as float * 2.3999632)
            bodies.append(world.create_rigid_body(Physics.RigidBody3DSettings()
                ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.2))
                ..transform = Physics.Transform3D(position:Math.Vec3(
                    -4.3 + (lane % 5) as float * 0.43, 5.2,
                    ((lane / 5) as float - 2.0) * 0.43 + spread * 0.01))
                ..linear_velocity = Math.Vec3(2.0, -1.0, spread * 0.6)
                ..friction = 0.6))
            emission -= 1.0
        }
        clock.tick()
        world.step(1.0 / 60.0)
        timings.append(clock.tick() * 1000.0)
        for body in bodies {
            let p = body.position()
            // Containment guards; these tolerate the current solver's shallow
            // wall penetration, not escape, tunnelling or a non-finite pose.
            // Report transient floor penetration; the existing solver does not
            // yet meet the separate 0.19 m center-height quality gate.
            assert(p.x == p.x && p.y == p.y && p.z == p.z)
            assert(Math.abs(p.x) < 4.95 && Math.abs(p.z) < 2.45)
            assert(p.y >= 0.0 && p.y <= 5.4)
            minimum_floor = Math.min(minimum_floor, p.y)
        }
        sum_ms += timings[step]
        if step % 60 == 59 {
            var awake = 0
            var min_y = 1000.0
            var max_y = -1000.0
            var min_z = 1000.0
            var max_z = -1000.0
            var min_x = 1000.0
            var max_x = -1000.0
            var fast = 0
            var spinning = 0
            var speed = 0.0
            var spin = 0.0
            for body in bodies {
                if body.is_awake() { awake++ }
                let p = body.position()
                min_y = Math.min(min_y,p.y); max_y = Math.max(max_y,p.y)
                min_z = Math.min(min_z,p.z); max_z = Math.max(max_z,p.z)
                min_x = Math.min(min_x,p.x); max_x = Math.max(max_x,p.x)
                if body.linear_velocity().length() > 0.05 { fast++ }
                if body.angular_velocity().length() > 0.05 { spinning++ }
                speed += body.linear_velocity().length()
                spin += body.angular_velocity().length()
            }
            print("$(step),$(timings[step]),$(awake),$(world.contact_count()),$(min_y),$(max_y),$(min_x),$(max_x),$(min_z),$(max_z),$(speed),$(spin),$(fast),$(spinning),$(sum_ms / 60.0),$(minimum_floor)")
            if step == 1799 {
                assert(bodies.count() == 1024 && world.body_count() == 1029)
                assert(max_x - min_x > 8.0 && max_z - min_z > 4.0)
                assert(max_y < 3.0)
            }
            sum_ms = 0.0
        }
        step++
    }
}
