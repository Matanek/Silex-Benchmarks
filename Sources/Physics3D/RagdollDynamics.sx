use GFX.Physics
use STD.Math

func run_case(case_id:int, rate:int, side:int) {
    var world_settings = Physics.World3DSettings()
    if case_id == 0 { world_settings.gravity = Math.Vec3() }
    var world = Physics.World3D(world_settings)
    let body = Physics.RigidBody3DSettings()
        ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.25))
        ..mass_properties = Physics.MassProperties3D(2.0,Math.Vec3(0.2))
        ..allow_sleep = false ..friction = 0.0
    var settings = Physics.Ragdoll3DSettings([
        Physics.RagdollPart3D(-1,body),
        Physics.RagdollPart3D(0,body,local_transform:Physics.Transform3D(Math.Vec3(0.5,0.0,0.0)),
            body_offset:Physics.Transform3D(Math.Vec3(0.5,0.0,0.0))),
        Physics.RagdollPart3D(1,body,local_transform:Physics.Transform3D(Math.Vec3(1.0,0.0,0.0)),
            body_offset:Physics.Transform3D(Math.Vec3(0.5,0.0,0.0)))
    ],self_collision:false)
    var ragdoll = world.create_ragdoll(settings,Physics.Transform3D(Math.Vec3(0.0,3.0,0.0)))
    if case_id == 0 {
        let impulse = Math.Vec3(0.0,0.0,3.0 * side as float)
        ragdoll.body(2).apply_impulse(impulse,ragdoll.body(2).world_center_of_mass().add(Math.Vec3(0.0,0.1,0.0)))
    } else {
        world.create_rigid_body(Physics.RigidBody3DSettings() ..body_type = Physics.BodyType3D.fixed
            ..shape = Physics.Shape3D.plane(Physics.Plane3D()) ..friction = 0.0)
    }
    var steps = rate / 2
    if case_id == 1 { steps = rate * 2 }
    var step = 0
    while step <= steps {
        var index = 0
        while index < 3 {
            var member = ragdoll.body(index)
            let p = member.world_center_of_mass();let v = member.linear_velocity();let w = member.angular_velocity()
            var anchor = 0.0
            if index > 0 { anchor = ragdoll.joint(index)!.anchor_error().length() }
            print("dynamic $(case_id) $(rate) $(side) $(step) $(index) $(p.x) $(p.y) $(p.z) $(v.x) $(v.y) $(v.z) $(w.x) $(w.y) $(w.z) $(anchor)")
            index++
        }
        if step == steps { break }
        world.step(1.0 / rate);step++
    }
    world.destroy_ragdoll(ragdoll)
    assert(world.swing_twist_constraint_count() == 0)
    assert(world.body_count() == case_id)
}
func main() {
    let sides:int[] = [-1,1]
    for case_id in [0,1] { for rate in [60,120] { for side in sides { run_case(case_id,rate,side) } } }
}
