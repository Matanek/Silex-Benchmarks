use GFX.Physics
use STD.Math

func run_combined_case(case_id:int) {
    var gravity = Math.Vec3()

    var world = Physics.World3D(Physics.World3DSettings() ..gravity = gravity)
    var first_type = Physics.BodyType3D.fixed
    if case_id == 7 { first_type = Physics.BodyType3D.dynamic }
    var first_settings = Physics.RigidBody3DSettings() ..body_type = first_type
        ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.5))
        ..allow_sleep = false ..collision_filter = Physics.CollisionFilter3D(mask_bits:0)
    if case_id == 7 { first_settings.mass_properties = Physics.MassProperties3D(1.0,Math.Vec3(0.1)) }
    var first = world.create_rigid_body(first_settings)
    var anchor = Math.Vec3(); var pose = Physics.Transform3D()
    var inertia = 0.1
    if case_id == 7 { inertia = 0.4 }
    if case_id == 5 { anchor = Math.Vec3(0.0,1.0,0.0); pose = Physics.Transform3D(Math.Vec3(0.0,-1.0,0.0)) }
    if case_id == 6 { pose = Physics.Transform3D(Math.Vec3(),Math.Quat.angle_axis(-3.0,Math.Vec3(0.0,0.0,1.0))) }
    if case_id == 4 { pose = Physics.Transform3D(rotation:Math.Quat.angle_axis(0.3,Math.Vec3(0.0,0.0,1.0))) }
    var second = world.create_rigid_body(Physics.RigidBody3DSettings() ..transform = pose
        ..shape = Physics.Shape3D.sphere(Physics.Sphere3D(0.5))
        ..mass_properties = Physics.MassProperties3D(1.0,Math.Vec3(inertia))
        ..allow_sleep = false ..collision_filter = Physics.CollisionFilter3D(mask_bits:0))
    var target = 0.5;var speed = 0.4;var minimum = -10.0;var maximum = 10.0
    var stiffness = 1.6;var damping = 0.8
    if case_id == 2 { target = 1.0;speed = 0.5;minimum = -0.02;maximum = 0.01;stiffness = 100.0;damping = 1.0 }
    if case_id == 4 { target = 0.8 }
    if case_id == 5 { minimum = -20.0;maximum = 20.0;stiffness = 17.6;damping = 8.8 }
    if case_id == 6 { target = 3.0;speed = -0.1 }
    var settings = Physics.HingeConstraint3DSettings() ..second_local_anchor = anchor
        ..motor = Physics.HingeMotor3D.position_and_velocity(target,speed,minimum,maximum,stiffness,damping)
    if case_id == 4 { settings.minimum_angle = -0.2;settings.maximum_angle = 0.3 }
    var hinge = world.create_hinge_constraint(first,second,settings)
    var step = 1
    while step <= 360 {
        if case_id == 1 {
            let time = (step-1) as float/60.0
            hinge.set_motor(Physics.HingeMotor3D.position_and_velocity(0.75*Math.sin(time*0.8),0.6*Math.cos(time*0.8),10.0,1.6,0.8))
        }
        if case_id == 2 && step == 181 { hinge.set_motor(Physics.HingeMotor3D.position_and_velocity(-1.0,-0.5,minimum,maximum,stiffness,damping)) }
        if case_id == 3 && step == 121 { hinge.set_motor(Physics.HingeMotor3D.position(-0.5,maximum,stiffness,damping)) }
        if case_id == 3 && step == 241 { hinge.set_motor(Physics.HingeMotor3D(0.5,maximum)) }
        if case_id == 3 && step == 301 { hinge.set_motor(null) }
        if case_id == 4 && step == 181 { second.set_transform(Physics.Transform3D(rotation:Math.Quat.angle_axis(-0.2,Math.Vec3(0.0,0.0,1.0))));second.set_angular_velocity(Math.Vec3());hinge.set_motor(Physics.HingeMotor3D.position_and_velocity(-0.8,-0.4,maximum,stiffness,damping)) }
        world.step(1.0 / 60.0)
        if step % 15 == 0 {
            print("combined $(case_id) $(step) $(second.position().x) $(second.position().y) $(hinge.angle()) $(hinge.angular_speed()) $(first.angular_velocity().z) $(second.angular_velocity().z) $(hinge.motor_torque()) $(hinge.anchor_error().length()) $(hinge.axis_error()) $(hinge.reaction_force().y)")
        }
        step++
    }
}
func main() { var i = 0; while i < 8 { run_combined_case(i); i++ } }
