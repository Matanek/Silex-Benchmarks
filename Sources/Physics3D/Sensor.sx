use GFX.Physics
use STD.Math

func main() {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed
        ..is_sensor = true)
    var moving = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(-2.0, 0.0, 0.0))
        ..linear_velocity = Math.Vec3(1.0, 0.0, 0.0)
        ..allow_sleep = false)
    var begins:Physics.Contact3D[] = []
    var ends:Physics.Contact3D[] = []
    var added = 0
    var removed = 0
    var persisted = 0
    var step = 0
    while step < 240 {
        world.step(1.0 / 60.0)
        world.write_contact_begin_events(begins)
        world.write_contact_end_events(ends)
        added += begins.count()
        removed += ends.count()
        if world.contact_count() > begins.count() {
            persisted += 1
        }
        step++
    }
    print("added=$(added)")
    print("removed=$(removed)")
    print("persisted=$(persisted)")
    print("final_x=$(moving.position().x)")
    print("final_vx=$(moving.linear_velocity().x)")
}
