use GFX.Physics
use STD.Math
func body_row(body:Physics.RigidBody3D) str {
    let p=body.position();let v=body.linear_velocity();let q=body.rotation();let w=body.angular_velocity()
    return " $(p.x) $(p.y) $(p.z) $(v.x) $(v.y) $(v.z) $(q.x) $(q.y) $(q.z) $(q.w) $(w.x) $(w.y) $(w.z)"
}
func run_case(kind:int,enabled:int,rate:int) {
    var gravity=Math.Vec3(0.0,-9.81,0.0);if kind==3 { gravity=Math.Vec3() }
    var world=Physics.World3D(Physics.World3DSettings() ..gravity=gravity)
    var ground=Physics.RigidBody3DSettings() ..body_type=Physics.BodyType3D.fixed ..friction=0.0
    ground.shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(20.0,1.0,20.0)))
    ground.transform=Physics.Transform3D(Math.Vec3(0.0,-0.5,0.0))
    if kind==4 { ground.shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(4.0,1.0,20.0)));ground.transform=Physics.Transform3D(Math.Vec3(2.0,-0.5,0.0)) }
    if kind==3 {
        ground.body_type=Physics.BodyType3D.dynamic;ground.shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(5.0,0.1,5.0)))
        ground.transform=Physics.Transform3D(Math.Vec3(0.0,-0.05,0.0));ground.mass_properties=Physics.MassProperties3D(200.0,Math.Vec3(100.0))
        ground.allow_sleep=false;ground.linear_damping=0.0;ground.angular_damping=0.0
    }
    var support=world.create_rigid_body(ground)
    var wheels:Physics.Wheel3DSettings[]=[];let sides:float[]=[-1.0,1.0]
    for x in sides { for z in sides { wheels.append(Physics.Wheel3DSettings(Math.Vec3(0.6*x,0.0,z),maximum_length:0.77985,stiffness:1200.0,damping:160.0)) } }
    var bars:Physics.VehicleAntiRollBar3DSettings[]=[];var stiffness=1000.0;if enabled==2 { stiffness=0.0 }
    if enabled!=0 { bars=[Physics.VehicleAntiRollBar3DSettings(0,2,stiffness),Physics.VehicleAntiRollBar3DSettings(1,3,stiffness)] }
    var tilt=0.0;if kind==3 || kind==4 { tilt=0.08 }
    var vehicle=world.create_wheeled_vehicle(Physics.WheeledVehicle3DSettings(
        Physics.RigidBody3DSettings() ..shape=Physics.Shape3D.box(Physics.Box3D(Math.Vec3(1.4,0.4,2.4)))
            ..mass_properties=Physics.MassProperties3D(100.0,Math.Vec3(100.0))
            ..transform=Physics.Transform3D(Math.Vec3(0.0,0.875475,0.0),Math.Quat.angle_axis(tilt,Math.Vec3(0.0,0.0,1.0)))
            ..allow_sleep=false ..linear_damping=0.0 ..angular_damping=0.0 ..friction=0.0,wheels,anti_roll_bars:bars))
    var total=rate*6;if kind==3 { total=rate }if kind==4 { total=rate/4 }
    var step=0
    while step<=total {
        var body=vehicle.chassis();var line="antiroll $(kind) $(enabled) $(rate) $(step)"+body_row(body)
        for i in [0,1,2,3] {
            var wheel=vehicle.wheel(i);var contact=0;if wheel.support()!=null { contact=1 }
            let p=wheel.contact_point;let n=wheel.contact_normal
            line+=" $(wheel.length) $(wheel.normal_force) $(contact) $(p.x) $(p.y) $(p.z) $(n.x) $(n.y) $(n.z)"
        }
        line+=body_row(support);print(line)
        if step==total { break }
        if kind==0 && step==2*rate { body.apply_impulse(Math.Vec3(0.0,500.0,0.0)) }
        if (kind==1 || kind==2) && step>=2*rate && step<4*rate {
            var torque=40.0;if kind==2 { torque= -40.0 }body.apply_torque(Math.Vec3(0.0,0.0,torque))
        }
        world.step(1.0/rate as float);step++
    }
    world.destroy_wheeled_vehicle(vehicle);assert(!vehicle.is_valid() && world.body_count()==1)
}
func main() { for kind in [0,1,2,3,4] { for enabled in [0,1,2] { for rate in [60,120] { run_case(kind,enabled,rate) } } } }
