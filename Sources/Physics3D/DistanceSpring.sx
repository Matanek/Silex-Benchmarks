use GFX.Physics
use STD.Math

func main() {
    var world = Physics.World3D(Physics.World3DSettings() ..gravity = Math.Vec3())
    var anchor = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..body_type = Physics.BodyType3D.fixed)
    var weight = world.create_rigid_body(Physics.RigidBody3DSettings()
        ..transform = Physics.Transform3D(position:Math.Vec3(3.0, 0.0, 0.0))
        ..allow_sleep = false
        ..linear_damping = 0.0
        ..angular_damping = 0.0)
    var settings = Physics.DistanceConstraint3DSettings(2.0)
    settings.spring_hertz = 2.0
    settings.spring_damping_ratio = 0.1
    var joint = world.create_distance_constraint(anchor, weight, settings)
    var step = 0
    while step < 120 {
        world.step(1.0 / 60.0)
        step++
        if step == 12 { print("length_12=$(joint.current_length())") }
        if step == 30 { print("length_30=$(joint.current_length())") }
        if step == 60 { print("length_60=$(joint.current_length())") }
        if step == 120 { print("length_120=$(joint.current_length())") }
    }
}
