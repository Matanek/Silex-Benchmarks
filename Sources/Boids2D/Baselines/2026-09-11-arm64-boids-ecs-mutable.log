# ECS CPU probe: same source, 4000 entities, 4000 updates, two mutable scalar components.
# Only update time is measured. These numbers are not Boids FPS or a LLVM comparison.
{
  "protocol": "4000 entities, 4000 updates, two mutable scalar components; timed updates only; one warmup then six alternating AB/BA pairs",
  "source": "use GFX.Application\nuse GFX.Application.Schedule\nuse GFX.ECS\nuse STD.Time.Clock\n\nstruct Position { var x:int; var y:int }\nstruct Velocity { var x:int; var y:int }\n\nfunc integrate(query:ECS.Query<(&Position, &Velocity)>) {\n    for (position, velocity) in query {\n        position.x += velocity.x\n        position.y += velocity.y\n        velocity.x += 1\n    }\n}\n\nfunc run_iterations(application:Application) int {\n    var clock = Clock()\n    clock.tick()\n    for frame in 0...4000 { application.run_schedule(Schedule.update) }\n    let elapsed = clock.tick()\n    var resources = application.resources()\n    let world:@ECS.World = resources.get<ECS.World>()\n    var checksum:int = 0\n    for entity in world.entities() {\n        let position = world.get<Position>(entity)\n        let velocity = world.get<Velocity>(entity)\n        assert(position.x == 8_002_000 && position.y == 8_000)\n        assert(velocity.x == 4_001 && velocity.y == 2)\n        checksum += position.x + position.y\n    }\n    print(\"ECS_MUTABLE elapsed=$(elapsed) checksum=$(checksum)\")\n    return 0\n}\n\nfunc main() {\n    var application = Application()\n        ..add_plugin(ECS.Plugin())\n        ..add_system(Schedule.update, integrate)\n        ..with_runner(run_iterations)\n    application.prepare()\n    if true {\n        var resources = application.resources()\n        var world:&ECS.World = resources.get_mut<ECS.World>()\n        for index in 0...4000 {\n            world.spawn(ECS.EntityRecipe()\n                ..with(Position(x:0, y:0))\n                ..with(Velocity(x:1, y:2)))\n        }\n    }\n    application.run()\n}\n",
