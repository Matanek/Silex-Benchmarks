func report(
    phase:str,
    family:str,
    backend:str,
    dtype:str,
    size:int,
    elements:int,
    bytes:int,
    transfer_mode:str,
    iterations:int,
    elapsed:@Stopwatch,
    uploads:int = 0,
    downloads:int = 0,
    compute_passes:int = 0
) {
    let milliseconds = elapsed.get_elapsed_milliseconds()
    print(
        "SILEX_TENSOR phase=$(phase) family=$(family) backend=$(backend) " +
        "dtype=$(dtype) size=$(size) elements=$(elements) bytes=$(bytes) " +
        "transfer_mode=$(transfer_mode) iterations=$(iterations) " +
        "elapsed_ms=$(milliseconds) per_iteration_ms=$(milliseconds / iterations as float) " +
        "uploads=$(uploads) downloads=$(downloads) compute_passes=$(compute_passes)"
    )
}

func measure_transfers<T>(
    device:GPU.Device,
    dtype:str,
    width:int,
    count:int,
    transfer_mode:str,
    sample:T,
    iterations:int
) {
    let values = filled<T>(count, sample)
    let cpu = Tensor.vector(values)
    var resident = cpu.to(device)
    device.wait_until_idle()

    device.reset_command_stats()
    var upload = Stopwatch()
    upload.start()
    var index = 0
    while index < iterations {
        resident = cpu.to(device)
        device.wait_until_idle()
        index++
    }
    upload.stop()
    let uploaded = device.command_stats()
    assert(uploaded.uploads == iterations && uploaded.downloads == 0)
    report(
        "upload", "transfer", "gpu", dtype, 0, count, count * width,
        transfer_mode, iterations, upload,
        uploads:uploaded.uploads, downloads:uploaded.downloads,
        compute_passes:uploaded.compute_passes
    )

    device.reset_command_stats()
    var download = Stopwatch()
    download.start()
    index = 0
    var copied = cpu
    while index < iterations {
        copied = resident.cpu()
        index++
    }
    download.stop()
    let downloaded = device.command_stats()
    assert(downloaded.uploads == 0 && downloaded.downloads == iterations)
    assert(extracted_count(copied, sample) == count)
    report(
        "download", "transfer", "gpu", dtype, 0, count, count * width,
        transfer_mode, iterations, download,
        uploads:downloaded.uploads, downloads:downloaded.downloads,
        compute_passes:downloaded.compute_passes
    )
}

func measure_dtype<T>(
    device:GPU.Device,
    dtype:str,
    width:int,
    count:int,
    sample:T,
    iterations:int
) {
    let values = filled<T>(count, sample)
    var tensor = Tensor.vector(values)
    var construction = Stopwatch()
    construction.start()
    var index = 0
    while index < iterations {
        tensor = Tensor.vector(values)
        index++
    }
    construction.stop()
    report(
        "construction", "cpu_memory", "cpu", dtype, 0, count, count * width,
        "equal_cardinality", iterations, construction
    )

    var extraction = Stopwatch()
    extraction.start()
    index = 0
    var count_guard = 0
    while index < iterations {
        count_guard = extracted_count(tensor, sample)
        index++
    }
    extraction.stop()
    assert(count_guard == count)
    report(
        "extraction", "cpu_memory", "cpu", dtype, 0, count, count * width,
        "equal_cardinality", iterations, extraction
    )

    measure_transfers<T>(
        device, dtype, width, count, "equal_cardinality", sample, iterations
    )
}

func measure_dtype_matrix(device:GPU.Device) {
    let count = 65_536
    let iterations = 5
    measure_dtype<float>(device, "float32", 4, count, 1.25, iterations)
    measure_dtype<int8>(device, "int8", 1, count, 7 as int8, iterations)
    measure_dtype<uint8>(device, "uint8", 1, count, 7 as uint8, iterations)
    measure_dtype<int16>(device, "int16", 2, count, 7 as int16, iterations)
    measure_dtype<uint16>(device, "uint16", 2, count, 7 as uint16, iterations)
    measure_dtype<int32>(device, "int32", 4, count, 7 as int32, iterations)
    measure_dtype<uint32>(device, "uint32", 4, count, 7 as uint32, iterations)
    measure_dtype<int64>(device, "int64", 8, count, 7 as int64, iterations)
    measure_dtype<uint64>(device, "uint64", 8, count, 7 as uint64, iterations)

    let bytes = 262_144
    measure_transfers<float>(device, "float32", 4, bytes / 4, "equal_bytes", 1.25, iterations)
    measure_transfers<int8>(device, "int8", 1, bytes, "equal_bytes", 7 as int8, iterations)
    measure_transfers<uint8>(device, "uint8", 1, bytes, "equal_bytes", 7 as uint8, iterations)
    measure_transfers<int16>(device, "int16", 2, bytes / 2, "equal_bytes", 7 as int16, iterations)
    measure_transfers<uint16>(device, "uint16", 2, bytes / 2, "equal_bytes", 7 as uint16, iterations)
    measure_transfers<int32>(device, "int32", 4, bytes / 4, "equal_bytes", 7 as int32, iterations)
    measure_transfers<uint32>(device, "uint32", 4, bytes / 4, "equal_bytes", 7 as uint32, iterations)
    measure_transfers<int64>(device, "int64", 8, bytes / 8, "equal_bytes", 7 as int64, iterations)
    measure_transfers<uint64>(device, "uint64", 8, bytes / 8, "equal_bytes", 7 as uint64, iterations)
}

func operation_iterations(family:str, size:int) int {
    if family == "matmul" {
        if size >= 512 { return 1 }
        if size >= 128 { return 3 }
        return 10
    }
    if size >= 1_048_576 { return 3 }
    return 10
}

func measure_cpu_elementwise(count:int) {
    let iterations = operation_iterations("elementwise", count)
    let source = Tensor.ones([count])
    var result = source
    var elapsed = Stopwatch()
    elapsed.start()
    var index = 0
    while index < iterations {
        result = source.add(1.0)
        index++
    }
    elapsed.stop()
    assert(result.values()[0] == 2.0)
    report(
        "hot", "elementwise", "cpu", "float32", count, count, count * 4,
        "none", iterations, elapsed
    )
}

func measure_gpu_elementwise(count:int) {
    let iterations = operation_iterations("elementwise", count)
    var device = GPU.Device()
    let source = Tensor.ones([count]).to(device)
    device.wait_until_idle()

    device.reset_command_stats()
    var cold = Stopwatch()
    cold.start()
    var result = source.add(1.0)
    device.wait_until_idle()
    cold.stop()
    let cold_stats = device.command_stats()
    assert(cold_stats.compute_passes == 1 && cold_stats.downloads == 0)
    report(
        "cold", "elementwise", "gpu", "float32", count, count, count * 4,
        "none", 1, cold,
        uploads:cold_stats.uploads, downloads:cold_stats.downloads,
        compute_passes:cold_stats.compute_passes
    )
    assert(result.cpu().values()[0] == 2.0)

    device.reset_command_stats()
    var hot = Stopwatch()
    hot.start()
    var index = 0
    while index < iterations {
        result = source.add(1.0)
        device.wait_until_idle()
        index++
    }
    hot.stop()
    let hot_stats = device.command_stats()
    assert(hot_stats.compute_passes == iterations && hot_stats.downloads == 0)
    report(
        "hot", "elementwise", "gpu", "float32", count, count, count * 4,
        "none", iterations, hot,
        uploads:hot_stats.uploads, downloads:hot_stats.downloads,
        compute_passes:hot_stats.compute_passes
    )
}

func measure_cpu_reduction(count:int) {
    let iterations = operation_iterations("reduction", count)
    let source = Tensor.ones([count])
    var result = Tensor.scalar(0.0)
    var elapsed = Stopwatch()
    elapsed.start()
    var index = 0
    while index < iterations {
        result = source.sum()
        index++
    }
    elapsed.stop()
    assert(result.item() == count as float)
    report(
        "hot", "reduction", "cpu", "float32", count, count, count * 4,
        "none", iterations, elapsed
    )
}

func measure_gpu_reduction(count:int) {
    let iterations = operation_iterations("reduction", count)
    var device = GPU.Device()
    let source = Tensor.ones([count]).to(device)
    device.wait_until_idle()

    device.reset_command_stats()
