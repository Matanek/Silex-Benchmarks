use GFX.GPU
use STD.Process
use STD.Time.Stopwatch
use Tensor

func filled<T>(count:int, value:T) T[] {
    var values:T[] = []
    var index = 0
    while index < count {
        values.append(value)
        index++
    }
    return values
}

func extracted_count(tensor:Tensor, expected:float) int {
    let values = tensor.values()
    assert(values[0] == expected && values[-1] == expected)
    return values.count()
}

func extracted_count(tensor:Tensor, expected:int8) int {
    let values = tensor.int8_values()
    assert(values[0] == expected && values[-1] == expected)
    return values.count()
}

func extracted_count(tensor:Tensor, expected:uint8) int {
    let values = tensor.uint8_values()
    assert(values[0] == expected && values[-1] == expected)
    return values.count()
}

